<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ButtonComponent"
             x:Class="VOID.APP.Components.Buttons.ButtonWithIcon">
    <Button 
        Classes="deleteMessageButton"
        CommandParameter="{Binding #ButtonComponent.CommandParameter, Mode=OneWay}"
        Command="{Binding #ButtonComponent.Command, Mode=OneWay}">
        <Button.ContentTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <PathIcon Data="{Binding #ButtonComponent.MyIconData, Mode=OneWay}"/>
                    <TextBlock Text="{Binding #ButtonComponent.Text, Mode=OneWay}"/>
                </StackPanel>
            </DataTemplate>
        </Button.ContentTemplate>
    </Button>
</UserControl>
