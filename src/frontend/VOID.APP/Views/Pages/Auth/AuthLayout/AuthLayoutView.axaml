<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VOID.APP.ViewModels.Pages.Auth.AuthLayout"
             x:DataType="vm:AuthLayoutViewModel"
             x:Class="VOID.APP.Views.Pages.Auth.AuthLayout.AuthLayoutView"
             Loaded="OnLoaded">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/Auth/AuthStyles.axaml"/>
    </UserControl.Styles>
    <Border Classes="mainBorder">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="VOID"
                           FontFamily="{StaticResource Comfortaa}"
                           FontWeight="700"
                           LetterSpacing="30"
                           FontSize="55"
                           Margin="30 20 0 0"
                           Classes="reginText"/>
                <Separator x:Name="Cursor"
                           Width="8"
                           CornerRadius="10"
                           Classes="cursorSeparator"
                           Height="8"/>
            </StackPanel>
            <StackPanel Classes="mainStack">
                <ContentControl
                    Content="{Binding CurrentAuthPage}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>