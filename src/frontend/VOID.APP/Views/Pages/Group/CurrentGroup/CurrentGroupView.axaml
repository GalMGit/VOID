<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VOID.APP.ViewModels.Pages.Group.CurrentGroup"
             xmlns:buttons="clr-namespace:VOID.APP.Components.Buttons"
             xmlns:converters="using:VOID.APP.Converters"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             x:DataType="vm:CurrentGroupViewModel"
             x:Class="VOID.APP.Views.Pages.Group.CurrentGroup.CurrentGroupView">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/Chat/UserChatStyles.axaml" />
    </UserControl.Styles>

    <UserControl.Resources>
        <converters:HorizontalMessageConverter x:Key="HorizontalAlignmentConverter" />
    </UserControl.Resources>

        <DockPanel LastChildFill="True">
            <SplitView
                x:Name="SplitChatInfo"
                Classes="chatRightSplitView"
                DockPanel.Dock="Right">
            <SplitView.Pane>
                <Border Classes="backChatsSplitBorder">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Информация"
                                       Classes="informationTextBlock" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="1">
                            <StackPanel>
                                <Border Width="80"
                                        Margin="10 0 10 0"
                                        ClipToBounds="True"
                                        Height="80"
                                        CornerRadius="80"
                                        Background="{DynamicResource MainBackground}">
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding CurrentGroup.ImageUrl}"
                                           Classes="groupImageAvatar">
                                        <Image.Styles>
                                            <Style Selector="Image.groupImageAvatar">
                                                <Setter Property="Width" Value="100"/>
                                                <Setter Property="Height" Value="100"/>
                                                <Setter Property="Stretch" Value="UniformToFill"/>
                                                <Setter Property="Margin" Value="5 -15 0 0"/>
                                                <Setter Property="Clip">
                                                    <Setter.Value>
                                                        <EllipseGeometry
                                                            RadiusX="100"
                                                            RadiusY="100"
                                                            Center="50,50"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Image.Styles>
                                    </Image>
                                </Border>

                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentGroup.ChatName}"
                                           FontFamily="{StaticResource JetBrainsMono}"
                                           Classes="interlocutorNameTextBlock" />

                            </StackPanel>
                        </StackPanel>
                        <Separator Height="2" Grid.Row="2" Background="{DynamicResource SeparatorForeground}"/>
                        <StackPanel Grid.Row="3">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <PathIcon Data="{StaticResource info_regular}"
                                          Classes="infoIcon" />
                                <StackPanel>
                                    <TextBlock Text="О себе"
                                               Classes="aboutMyselfTextBlock" />
                                    <TextBlock Text="Info"
                                               Classes="infoChatTextBlock">
                                    </TextBlock>
                                </StackPanel>

                            </StackPanel>
                            <Button Content="Добавить участника"
                                    HorizontalAlignment="Center"
                                    Classes="editGroupButton"
                                    Command="{Binding AddMemberCommand}"/>
                            <Button Content="Редактировать"
                                    HorizontalAlignment="Center"
                                    Classes="editGroupButton"
                                    Command="{Binding OpenEditGroupCommand}"
                                    IsVisible="{Binding CurrentGroup.IsOwner}"/>
                            <TextBlock
                                Text="{Binding CurrentGroup.MessageCount,
                                        StringFormat='Сообщений в чате: {0}'}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                        <Grid RowDefinitions="*" Grid.Row="4">
                            <ScrollViewer VerticalScrollBarVisibility="Visible" Grid.Row="0">
                                <ListBox ItemsSource="{Binding CurrentGroup.Members}"
                                         Classes="groupMembers">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <TextBlock Text="{Binding Username}"
                                                           Grid.Column="0"/>
                                                <TextBlock Text="{Binding GroupRole}"
                                                           Grid.Column="1"
                                                           Classes="groupRoleTextBlock"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </SplitView.Pane>
        </SplitView>
        <StackPanel DockPanel.Dock="Top">
            <Border Classes="backTopHeaderBorder">
                <Grid ColumnDefinitions="*, Auto">
                    <Grid RowDefinitions="*,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button Classes="openProfileButton"
                                Content="{Binding CurrentGroup.ChatName}" />
                        </StackPanel>
                    </Grid>
                    <ToggleButton
                        x:Name="ToggleButton"
                        Classes="splitToggle"
                        IsChecked="{Binding #SplitChatInfo.IsPaneOpen}"
                        Grid.Column="1">
                        <ToggleButton.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <PathIcon
                                        IsVisible="{Binding !#ToggleButton.IsChecked}"
                                        Data="{StaticResource pane_open_regular}" />
                                    <PathIcon
                                        IsVisible="{Binding #ToggleButton.IsChecked}"
                                        Data="{StaticResource pane_close_regular}" />
                                </StackPanel>
                            </DataTemplate>
                        </ToggleButton.ContentTemplate>
                    </ToggleButton>
                </Grid>
            </Border>
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*, Auto, Auto, Auto"
              DockPanel.Dock="Bottom">
            <Button Width="35"
                    Classes="sendMediaButton"
                    Command="{Binding SendMediaMessageCommand}">
                    <PathIcon Data="{StaticResource attach_regular}"/>
            </Button>
            <TextBox Grid.Column="1"
                     x:Name="TextBox"
                     Watermark="Введите сообщение"
                     Classes="enterMessageBox"
                     Text="{Binding MessageText}">
                <TextBox.KeyBindings>
                    <KeyBinding
                        Gesture="Enter"
                        Command="{Binding SendOrUpdateMessageCommand}" />
                    <KeyBinding
                        Gesture="Escape"
                        Command="{Binding CancelEditingCommand}"/>
                </TextBox.KeyBindings>
                <TextBox.InnerRightContent>
                    <Button Content=">" IsVisible="False"/>
                </TextBox.InnerRightContent>
            </TextBox>
            <Button
                Grid.Column="2"
                IsVisible="{Binding IsEditing}"
                Content="Отменить" Command="{Binding CancelEditingCommand}"/>
            <TextBlock Grid.Column="2"
                       IsVisible="{Binding IsRecording}"
                       VerticalAlignment="Center"
                       Margin="0 0 5 0"
                       Text="{Binding RecordingDurationText}"/>
            <Button
                Grid.Column="3"
                IsVisible="{Binding !IsRecording}"
                Command="{Binding StartVoiceRecordingCommand}">
                <PathIcon Data="{StaticResource mic_on_regular}"/>
            </Button>
            <Button
                Grid.Column="3"
                IsVisible="{Binding IsRecording}"
                Command="{Binding StopVoiceRecordingCommand}">
                <PathIcon Data="{StaticResource mic_off_regular}"
                          Foreground="DarkRed"/>
            </Button>
            <Button
                Grid.Column="4"
                IsVisible="{Binding !IsEditing}"
                x:Name="ScrollButton"
                Command="{Binding ScrollToBottomCommand}">
                <PathIcon Data="{StaticResource arrow_down_regular}"/>
            </Button>
        </Grid>
            <StackPanel DockPanel.Dock="Bottom">
                <Border
                    Margin="8,0,8,0"
                    IsVisible="{Binding IsUploading}"
                    CornerRadius="6"
                    Padding="8">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto, Auto">
                            <TextBlock
                                Text="{Binding UploadFileName}"
                                TextTrimming="CharacterEllipsis"
                                FontSize="12" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding UploadProgress, StringFormat={}{0}%}"
                                FontSize="12"
                                Margin="8,0,0,0" />
                            <Button Grid.Column="2"
                                    Width="15"
                                    Height="15"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="20"
                                    FontSize="10"
                                    Background="DarkRed"
                                    Command="{Binding CancelUploadCommand}"
                                    IsVisible="{Binding IsUploading}"/>
                        </Grid>
                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Height="4"
                            Foreground="{DynamicResource TextDefault}"
                            Value="{Binding UploadProgress}" />
                        <TextBlock Text="Обработка сервера..."
                                   FontSize="10"
                                   IsVisible="{Binding IsUploaded}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        <Border>
            <ScrollViewer x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Visible">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CurrentGroup.IsCleared}"
                            Text="История очищена"
                            Classes="historyClearedTextBlock"/>
                        <ListBox
                        x:Name="MessageListBox"
                        ItemsSource="{Binding Messages}"
                        Classes="ListStyle">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0"
                                            IsVisible="{Binding !IsMine}">
                                        <Grid>
                                            <TextBlock Text="{Binding Character}"
                                                       Classes="avatarCharTextBlock"
                                                       IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding AvatarUrl}"
                                                   Width="60"
                                                   IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty }}"
                                                   Height="60"
                                                   Classes="avatarMessage"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1"
                                        HorizontalAlignment="{Binding IsMine, Converter={StaticResource HorizontalAlignmentConverter}}"
                                        Classes="itemMessage">
                                    <Grid RowDefinitions="*" ColumnDefinitions="*,Auto">
                                        <Grid ColumnDefinitions="*" RowDefinitions="Auto, *">
                                            <TextBlock Text="{Binding AuthorName}"
                                                       Classes="authorNameTextBlock"
                                                       Grid.Row="0"
                                                       IsVisible="{Binding !IsMine}"/>
                                            <SelectableTextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Classes="messageText"
                                                IsVisible="{Binding !IsMedia}"
                                                Text="{Binding Text}" />
                                        <Border IsVisible="{Binding IsImage}"
                                                Grid.Column="0"
                                                Classes="messageBorder"
                                                Grid.Row="1">
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding ImageThumbnailUrl}"
                                                   Width="200"
                                                   Height="200"
                                                   Cursor="Hand"
                                                   x:Name="ImageMessage"
                                                   PointerPressed="InputElement_OnPointerPressed">
                                            </Image>
                                        </Border>
                                        <Border
                                                Grid.Column="0"
                                                Classes="messageBorder"
                                                IsVisible="{Binding IsAudio}"
                                                Padding="5">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="10">
                                                    <Button
                                                        Width="45"
                                                        Height="45"
                                                        CornerRadius="10"
                                                        Content="▶"
                                                        FontSize="20"
                                                        IsVisible="{Binding !IsPlaying}"
                                                        VerticalAlignment="Bottom"
                                                        Classes="playstopButton"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding #MessageListBox.((vm:CurrentGroupViewModel)DataContext).PlayAudioCommand}"
                                                        CommandParameter="{Binding}" />
                                                    <Button
                                                        Width="45"
                                                        Height="45"
                                                        CornerRadius="10"
                                                        Content="⏹"
                                                        Classes="playstopButton"
                                                        FontSize="20"
                                                        VerticalContentAlignment="Center"
                                                        IsVisible="{Binding IsPlaying}"
                                                        Command="{Binding #MessageListBox.((vm:CurrentGroupViewModel)DataContext).StopAudioCommand}"
                                                        CommandParameter="{Binding}"/>
                                                    <StackPanel
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="Голосовое сообщение"
                                                            Classes="messageText" />
                                                        <TextBlock
                                                            Text="WAV"
                                                            Opacity="0.6"
                                                            FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        <Border Grid.Column="0"
                                                Grid.Row="1"
                                                Classes="messageBorder"
                                                IsVisible="{Binding IsGif}">
                                            <Image
                                                anim:ImageBehavior.AnimatedSource="{Binding GifUrl}"
                                                Width="200"
                                                Height="200"/>
                                        </Border>
                                            <Border IsVisible="{Binding IsVideo}"
                                                    Classes="messageBorder"
                                                    Grid.Column="0">
                                                <Border Background="Transparent"
                                                        Width="300"
                                                        x:Name="VideoMessage"
                                                        Cursor="Hand"
                                                        PointerPressed="InputVideoElement_OnPointerPressed"
                                                        Height="200">
                                                    <Grid>
                                                        <Image asyncImageLoader:ImageLoader.Source="{Binding VideoThumbnailUrl}"
                                                               Width="300"
                                                               Height="200"
                                                               Cursor="Hand">
                                                        </Image>
                                                        <PathIcon
                                                            Data="{StaticResource video_regular}"
                                                            Width="60"
                                                            Height="60"/>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="(изменено)"
                                            IsVisible="{Binding IsEdited}"
                                            Grid.Column="0"
                                            Classes="isEditedTextBlock"/>
                                        </Grid>
                                        <TextBlock
                                            Grid.Row="0"
                                            Classes="messageTimeText"
                                            Text="{Binding CreatedAt, StringFormat='HH:mm'}"
                                            Grid.Column="1" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            Classes="checkMarkStackPanel"
                                            IsVisible="{Binding IsMine}">
                                            <PathIcon
                                                Height="12"
                                                Width="12"
                                                Data="{StaticResource checkmark_regular}"/>
                                            <PathIcon
                                                Height="12"
                                                Width="12"
                                                Classes="checkMarkTruePathIcon"
                                                IsVisible="{Binding IsRead}"
                                                Data="{StaticResource checkmark_regular}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border.ContextFlyout>
                                        <Flyout>
                                            <StackPanel>
                                                <buttons:ButtonWithIcon
                                                    MyIconData="{StaticResource delete_regular}"
                                                    IsVisible="{Binding IsMine}"
                                                    Command="{Binding #MessageListBox.((vm:CurrentGroupViewModel)DataContext).DeleteMessageCommand}"
                                                    CommandParameter="{Binding}"
                                                    Text="Удалить" />
                                                <buttons:ButtonWithIcon
                                                    MyIconData="{StaticResource edit_regular}"
                                                    IsVisible="{Binding IsMineAndNotMedia}"
                                                    Command="{Binding #MessageListBox.((vm:CurrentGroupViewModel)DataContext).StartEditMessageCommand}"
                                                    CommandParameter="{Binding}"
                                                    Text="Редактировать"/>
                                                <buttons:ButtonWithIcon
                                                    MyIconData="{StaticResource copy_regular}"
                                                    Command="{Binding #MessageListBox.((vm:CurrentGroupViewModel)DataContext).CopyMessageCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding !IsMedia}"
                                                    Text="Копировать текст"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Border.ContextFlyout>
                                </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>