<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VOID.APP.ViewModels.Pages.Settings.ChangePassword"
             x:DataType="vm:ResetPasswordViewModel"
             x:Class="VOID.APP.Views.Pages.Settings.ChangePassword.ResetPasswordView">
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0">
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding !IsCodeSend}">
            <StackPanel
                        IsVisible="{Binding !IsEmailSend}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <TextBox Watermark="Введите почту"
                         Margin="0 0 -1 10"
                         Text="{Binding Email}"
                         MaxLength="100"
                         HorizontalAlignment="Stretch"/>
                <Button Command="{Binding SendResetPasswordCommand}"
                        HorizontalAlignment="Center"
                        Content="Запросить код"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsEmailSend}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                <TextBox Watermark="Введите код из почты"
                         Margin="0 0 -1 10"
                         MaxLength="5"
                         Text="{Binding Code}"
                         HorizontalAlignment="Stretch"/>
                <Button Command="{Binding SendCodeCommand}"
                        HorizontalAlignment="Center"
                        Content="Подтвердить"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsCodeSend}">
            <StackPanel VerticalAlignment="Center">
                <TextBox Watermark="Введите новый пароль"
                         Margin="0 0 -1 10"
                         Text="{Binding NewPassword}"
                         MaxLength="40"
                         HorizontalAlignment="Stretch"/>
                <Button Command="{Binding CreateNewPasswordCommand}"
                        HorizontalAlignment="Center"
                        Content="Создать"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
