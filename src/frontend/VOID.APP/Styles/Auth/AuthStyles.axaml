<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
    </Style>
    <Style Selector="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0 5 0 0"/>
    </Style>

    <Style Selector="StackPanel.stack">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.mainStack">
        <Setter Property="Width" Value="500"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.reginText">
        
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect OffsetX="0"
                                  OffsetY="0"
                                  Color="{DynamicResource ShadowDrop}"
                                  BlurRadius="30" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="TextBlock.errorMessageText">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorMessageForeground}"/>
        <Setter Property="Margin" Value="0 10 0 0"/>
    </Style>
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
       <Setter Property="HorizontalContentAlignment" Value="Center"/>
       <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource TextBoxMain}"/>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0 10 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="Silver"/>
        <Setter Property="CaretBrush" Value="Silver"/>
        <Style Selector="^:focus /template/ Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxFocus}"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource TextBoxMain}"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
    </Style>

    <Style Selector="Button.in">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="5 0 0 0"/>
    </Style>
    <Style Selector="Button.reg">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0 0 0 0"/>
    </Style>
    <Style Selector="Border.mainBorder">
        <Setter Property="Background" Value="{DynamicResource MainBackground}"/>
    </Style>
    <Style Selector="Separator.cursorSeparator">
        <Setter Property="Background" Value="{DynamicResource TextDefault}"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Margin" Value="-25,55,0,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect 
                    OffsetX="0"
                    OffsetY="0"
                    Color="{DynamicResource ShadowDrop}"
                    BlurRadius="30" />
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Grid.buttonsGrid">
        <Setter Property="Margin" Value="0 10 0 0"/>
    </Style>
    
    <Style Selector="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Style Selector="^:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Style>

</Styles>