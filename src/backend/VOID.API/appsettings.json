{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Wolverine": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "PublicStorageOptions" : {
    "ServiceUrl": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "BaseUrl": ""
  },
  "PrivateStorageOptions" : {
    "ServiceUrl": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": ""
  },
  "ApiOptions": {
    "BaseUrl": "",
    "ApiPrefix": "/api"
  },
  "JwtOptions" : {
    "SecretKey": "",
    "Expires": ""
  },
  "EmailOptions": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "SenderEmail": "",
    "SenderName": ""
  },
  "Encryption": {
    "Key": ""
  }
}